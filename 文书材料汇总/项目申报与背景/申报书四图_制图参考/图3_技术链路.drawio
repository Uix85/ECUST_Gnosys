<mxCell id="f3_s1" value='&lt;b&gt;1  书籍导入&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px;color:#6B7280"&gt;EPUB / TXT 接入&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px;color:#2E7D5B"&gt;已完成&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3EC;strokeColor=#8FC7A8;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="310" height="105" as="geometry"/></mxCell>
