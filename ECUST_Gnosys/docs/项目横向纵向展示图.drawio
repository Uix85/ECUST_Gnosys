        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-155" parent="UPNYZquBfaD_xTY0HJsy-153" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#4D4D4D;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;定位系统与索引机制&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="22.06" width="170" x="21.24" y="3.68" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-279" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;读者在读到具体段落或句子时，能借语义层把握该段或句的字面意思、语义逻辑、指代和上下文如何限定含义，从而降低逐句理解门槛，并能顺着解释回到原文继续细读。&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="165" x="545" y="2030" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-282" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;把长篇文本压缩成可携带的总体框架，降低全书认知负荷，为章节、语义、概念层提供全局约束。&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="165" x="105" y="2245" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-283" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;读者进入一章前，先看到本章总体结构和论证链，能按结构定位到具体部分，再进入段落细读。&amp;nbsp;&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="165" x="325" y="2245" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-284" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;具体语义是阅读落地的最小单位；降低逐句细读门槛，为章节层提供段落材料，为概念层提供语境参考。&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="165" x="545" y="2250" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-285" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;哲学社会科学文本概念密度高，术语多义和译名差异容易造成理解偏差；概念层保证跨章理解一致，支撑概念辨析和概念转变。&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="165" x="765" y="2245" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-288" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;全书概览&lt;/b&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;核心问题&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;结构地图&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;论证主线&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;章节关系&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="100" x="131" y="2430" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-289" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;章节定位&lt;/b&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;总体结构&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;论证链条&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;部分作用&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;承上启下&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;原文证据&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="100" x="351" y="2430" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-290" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;要点&lt;/b&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;释义&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;知识补充&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;上下文说明原文引用&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="100" x="571" y="2430" as="geometry" />
