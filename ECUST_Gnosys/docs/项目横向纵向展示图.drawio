        <mxCell id="UPNYZquBfaD_xTY0HJsy-269" parent="UPNYZquBfaD_xTY0HJsy-218" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=4;strokeColor=#82b366;" value="" vertex="1">
          <mxGeometry height="140" width="990" x="-70" y="160" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-271" parent="UPNYZquBfaD_xTY0HJsy-218" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;以整本书为阅读单位，构建全书问题意识、结构地图、论证主线以及章节关系等宏观阅读任务。&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="150" x="75" y="170" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-272" parent="UPNYZquBfaD_xTY0HJsy-218" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;以章为阅读单位，梳理本章论证逻辑、各部分在整体中的功能以及章际承接关系等章节级任务。&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="150" x="295" y="170" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-273" parent="UPNYZquBfaD_xTY0HJsy-218" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;以段落或句子为解释单元，处理具体语义、句段关系、上下文指代以及原文引用等微观阅读任务。&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="150" x="515" y="170" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-274" parent="UPNYZquBfaD_xTY0HJsy-218" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;以概念、术语或词汇为解释单元，处理定义、义项、辨析、概念关系以及文本证据等概念层任务。&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="150" x="735" y="170" as="geometry" />
        </mxCell>
        <mxCell id="EgJZYEE78PbKzBJt_AQf-268" parent="UPNYZquBfaD_xTY0HJsy-218" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;定义&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="100" x="-50.05" y="202.5" as="geometry" />
        </mxCell>
        <mxCell id="EgJZYEE78PbKzBJt_AQf-301" parent="UPNYZquBfaD_xTY0HJsy-218" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" value="&lt;span style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;目标&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="100" x="-50.05" y="392.5" as="geometry" />
        </mxCell>
        <mxCell id="EgJZYEE78PbKzBJt_AQf-302" parent="UPNYZquBfaD_xTY0HJsy-218" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;意义&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="100" x="-50.05" y="592.5" as="geometry" />
        </mxCell>
        <mxCell id="EgJZYEE78PbKzBJt_AQf-303" parent="UPNYZquBfaD_xTY0HJsy-218" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bac8d3;strokeColor=#23445d;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;输出&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="100" x="-50.05" y="767.5" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-277" parent="UPNYZquBfaD_xTY0HJsy-34" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;读者在进入正文前，能借全书层把握全书的核心论证问题、总体结构和论证走向，从而判断各章在全书中的位置和阅读顺序，并能带着全书框架进入后续阅读 。&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="180" width="165" x="-65" y="2010" as="geometry" />
        </mxCell>
        <mxCell id="UPNYZquBfaD_xTY0HJsy-278" parent="UPNYZquBfaD_xTY0HJsy-34" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;读者在进入一章前，能借章节层把握本章的总体论证结构，知道各部分在章内的位置和推进关系，从而按结构定位到具体部分，带着论证框架进入段落细读。&amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="180" width="165" x="155" y="2010" as="geometry" />
