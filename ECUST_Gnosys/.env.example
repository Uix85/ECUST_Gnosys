# OpenAI-compatible Chat Completions endpoint. Keep the API key in .env.secrets.
AGENT_API_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=deepseek-v4.1-flash

# 部分中转（如 opencode.ai 的 Go 订阅路由）要求带会话标识头，留空则不发
AGENT_SESSION_ID=

# Per-request timeout in seconds.
AGENT_REQUEST_TIMEOUT=90

# Per paragraph: 12 total model requests, 20 tool calls, and five minutes.
AGENT_MAX_REQUESTS=12
AGENT_MAX_TOOL_CALLS=20
AGENT_RUN_TIMEOUT=300

# 单次模型请求的重试次数（429 / 5xx / 超时）与退避基数（秒）
AGENT_MAX_RETRIES=2
AGENT_RETRY_BASE_DELAY=2

# Maximum number of paragraph tasks running at once across the process.
AGENT_MAX_PARALLEL=2

